{
  "name": "warranty-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A private, local-first vault for receipts, invoices and warranties. Save it now. Find it later.",
  "license": "MIT",
  "author": "Saad Amjad",
  "repository": {
    "type": "git",
    "url": "https://github.com/saadamjad/warranty-tracker.git"
  },
  "homepage": "https://github.com/saadamjad/warranty-tracker#readme",
  "bugs": {
    "url": "https://github.com/saadamjad/warranty-tracker/issues"
  },
  "keywords": [
    "warranty",
    "receipts",
    "local-first",
    "pwa",
    "nextjs",
    "offline"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate && node scripts/copy-vendor-assets.mjs",
    "test:db": "vitest run --config vitest.db.config.mts",
    "e2e": "node e2e/acceptance.mjs && node e2e/sync.mjs && node e2e/a11y.mjs",
    "vercel-build": "node scripts/migrate-on-deploy.mjs && next build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@prisma/client": "^6.19.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "jszip": "^3.10.2",
    "minisearch": "^7.2.0",
    "next": "15.5.26",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.0.15",
    "pdfjs-dist": "^6.4.299",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "postcss": "^8.5.29",
    "source-map-js": "^1.2.2",
    "deepmerge-ts": "^8.0.2"
  }
}
