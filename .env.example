# Copy to .env.local and fill in. Never commit real values (the repo is public).
# On the live site (APP_ENV=production) the app refuses to start unless APP_URL is https,
# SMTP_* and a real EMAIL_FROM are set, STORAGE_DIR is absolute, and AUTH_SECRET/CRON_SECRET are 32+ chars.

# MySQL/MariaDB (docker compose defaults). On Hostinger: mysql://<user>:<password>@localhost:3306/<database>
DATABASE_URL="mysql://vault:vault@localhost:3307/vault"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Folder for document files. Live: an absolute path OUTSIDE the app folder, or redeploys erase it
# (Hostinger: /home/<user>/vault-files). Dev default: .storage in the project.
STORAGE_DIR=".storage"

# Email for magic links + reminders. Leave SMTP_HOST empty in dev: links print to the terminal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Purchase Vault <no-reply@example.com>"

# Public address of the app, used in email links
APP_URL="http://localhost:3000"

# Protects /api/cron/* (sent as a Bearer token by Vercel Cron, or by .github/workflows/daily-jobs.yml)
CRON_SECRET=""

# Live only, on hosts other than Vercel (Hostinger): "production" turns on the checks above and migrations
APP_ENV=""

# Disposable database for npm run test:db (its rows are deleted by tests)
TEST_DATABASE_URL="mysql://vault:vault@localhost:3307/vault_test"
