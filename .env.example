# Copy to .env.local and fill in. Never commit real values (the repo is public).

# Postgres (docker compose defaults)
DATABASE_URL="postgresql://vault:vault@localhost:5433/vault"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# S3-compatible storage (S3Mock locally, accepts any keys; Cloudflare R2 in prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="vault-documents"
S3_ACCESS_KEY_ID="dev"
S3_SECRET_ACCESS_KEY="dev"

# Email for magic links + reminders. Leave SMTP_HOST empty in dev: links print to the terminal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Purchase Vault <no-reply@example.com>"

# Public address of the app, used in email links
APP_URL="http://localhost:3000"

# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=""

# Disposable database for npm run test:db (its rows are deleted by tests)
TEST_DATABASE_URL="postgresql://vault:vault@localhost:5433/vault_test"
